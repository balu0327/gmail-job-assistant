# Copy to .env and fill in. Never commit .env.

# Primary: NVIDIA hosted endpoint (OpenAI-compatible). Key from build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Fallback: local Ollama (leave OLLAMA_MODEL empty to disable).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Local files (paths are relative to this folder)
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json
PROFILE=profile.json
TRACKER_DB=tracker.db

# Monitoring. Every run is logged to logs/runs.jsonl (no email text); see `stats`.
RUN_LOG=logs/runs.jsonl

# Optional: also send traces to Langfuse (keys from your Langfuse project settings).
# Leave the keys empty to keep everything local.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
# false: Langfuse gets timing, tokens, model, category and errors, but no email text or replies.
# true: prompts, email text and model replies are sent too.
LANGFUSE_SEND_CONTENT=false
