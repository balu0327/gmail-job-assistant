# Copy to .env and fill in. Never commit .env.

# Primary: NVIDIA hosted endpoint (OpenAI-compatible). Key from build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Fallback: local Ollama (leave OLLAMA_MODEL empty to disable).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Local files (paths are relative to this folder)
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json
PROFILE=profile.json
TRACKER_DB=tracker.db
